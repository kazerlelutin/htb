# Network and PostgreSQL
HTBD_LISTEN_ADDR=:8080
HTBD_DATABASE_URL=postgres://htb:change-me@127.0.0.1:5432/htb?sslmode=disable

# Zitadel API validation (required)
HTBD_ZITADEL_ISSUER=https://zitadel.example.org
# ZITADEL project ID, not the Device Code client ID.
HTBD_ZITADEL_AUDIENCE=replace-with-your-htb-project-id
# Public Native / Device Code client ID. The CLI fetches it from HTB.
HTBD_ZITADEL_DEVICE_CLIENT_ID=replace-with-your-htb-cli-client-id
# Optional web OIDC client for browser access. Leave unset until configured.
# HTBD_ZITADEL_WEB_CLIENT_ID=replace-with-your-htb-web-client-id
# At least 32 random bytes; never reuse the CLI client ID or another secret.
# HTBD_WEB_SESSION_KEY=replace-with-a-strong-random-secret
HTBD_ZITADEL_SUPERADMIN_CLAIM=urn:zitadel:iam:org:project:roles
HTBD_ZITADEL_SUPERADMIN_ROLE=superadmin

# Public GitHub Releases page shown by /downloads
HTBD_RELEASE_URL=https://github.com/your-organisation/htb/releases
# Canonical URL used by public pages and legal documents.
HTBD_PUBLIC_URL=https://htb.ben-to.fr

# Future account-level project quotas. Keep disabled until commercial offers are ready.
HTBD_ENFORCE_PROJECT_LIMITS=false
